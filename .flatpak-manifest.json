{
    "id": "io.github.pacificnm.kathenaeum",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.9",
    "sdk": "org.kde.Sdk",
    "base": "io.qt.qtwebengine.BaseApp",
    "base-version": "6.9",
    "command": "kathenaeum",
    "tags": [
        "nightly"
    ],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-documents",
        "--filesystem=xdg-download:ro",
        "--talk-name=org.kde.khelpcenter"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "xapian-core",
            "config-opts": [
                "--disable-documentation",
                "--disable-backend-remote"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://oligarchy.co.uk/xapian/1.4.25/xapian-core-1.4.25.tar.xz",
                    "sha256": "0c99dfdd817571cb5689bc412a7e021407938313f38ea3a70fa3bf86410608ee"
                }
            ],
            "cleanup": [
                "/bin",
                "/share/doc",
                "/share/xapian-core"
            ]
        },
        {
            "name": "libzim",
            "buildsystem": "meson",
            "config-opts": [
                "-Dexamples=false",
                "-Dtests=false",
                "-Ddoc=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/openzim/libzim/archive/refs/tags/9.2.3.tar.gz",
                    "sha256": "7c6e7fcaf5bc82447edb12c6c573779af6d77b3b79227da57586e81c4e13f1bf"
                }
            ]
        },
        {
            "name": "aria2",
            "config-opts": [
                "--without-gnutls",
                "--with-openssl",
                "--without-libssh2",
                "--without-sqlite3"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/aria2/aria2/releases/download/release-1.37.0/aria2-1.37.0.tar.xz",
                    "sha256": "60a420ad7085eb616cb6e2bdf0a7206d68ff3d37fb5a956dc44242eb2f79b66b"
                }
            ],
            "cleanup": [
                "/share/doc",
                "/share/locale"
            ]
        },
        {
            "name": "ktexteditor",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/6.13/ktexteditor-6.13.0.tar.xz",
                    "sha256": "7c12ef061f45bdc3b5ecc5c0eec9089cd6521c499217de07a273dc65fdd7c7cf"
                }
            ]
        },
        {
            "name": "kirigami-addons",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/kirigami-addons/kirigami-addons-1.7.0.tar.xz",
                    "sha256": "7d854975185cf740de486d84f1e2ec3e4eadb66ac9fb897214cba9ab8cc492b1"
                }
            ]
        },
        {
            "name": "marble",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_MARBLE_APPS=OFF",
                "-DBUILD_MARBLE_TOOLS=OFF",
                "-DBUILD_MARBLE_EXAMPLES=OFF",
                "-DWITH_DESIGNER_PLUGIN=OFF",
                "-DBUILD_WITH_DBUS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/25.04.0/src/marble-25.04.0.tar.xz",
                    "sha256": "27bdf174215a66136795ef3d0a7a2f3e09d21b12d2c83ec3309d84389dd52909"
                }
            ],
            "cleanup": [
                "/share/doc",
                "/share/locale/*/LC_MESSAGES/marble_qt.qm"
            ]
        },
        {
            "name": "kathenaeum",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
